[Unit]
Description=DVM Nexus Web Management Interface
Documentation=https://github.com/DVMProject/dvmhost
After=network.target dvmhost.service
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dvm-nexus
ExecStart=/opt/dvm-nexus/venv/bin/python run_nexus.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=NEXUS_HOST=0.0.0.0
Environment=NEXUS_PORT=8080

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
